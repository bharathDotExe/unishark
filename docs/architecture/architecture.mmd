%% UniShark Architecture
%% Source of truth: repository scan on 2026-06-07.
flowchart LR
  classDef client fill:#f8fafc,stroke:#94a3b8,color:#0f172a,stroke-width:1px
  classDef frontend fill:#eef2ff,stroke:#6366f1,color:#111827,stroke-width:1px
  classDef backend fill:#ecfdf5,stroke:#10b981,color:#064e3b,stroke-width:1px
  classDef database fill:#fff7ed,stroke:#f97316,color:#431407,stroke-width:1px
  classDef external fill:#fdf2f8,stroke:#db2777,color:#500724,stroke-width:1px
  classDef infra fill:#f1f5f9,stroke:#475569,color:#0f172a,stroke-width:1px
  classDef critical fill:#fef2f2,stroke:#ef4444,color:#450a0a,stroke-width:2px

  subgraph ClientApplications["Client Applications"]
    Browser["Web Browser"]
    Public["Public Visitors"]
    Students["Student Founders"]
    Investors["Investors"]
    Admins["Admins / Superadmins"]
  end

  subgraph Frontend["Frontend"]
    SPA["Vite React SPA<br/>React + TypeScript"]
    Router["React Router<br/>public, protected, role routes"]
    AuthGuard["AuthProvider + ProtectedRoute<br/>session + role state"]
    Query["TanStack Query<br/>client query/cache layer"]
    UI["Radix UI + Tailwind<br/>shadcn-style components"]
    Client["Supabase JS Client<br/>browser-side SDK"]
  end

  subgraph BackendServices["Backend Services"]
    Auth["Supabase Auth<br/>email/password, OTP, OAuth, sessions"]
    DataAPI["Supabase Data API / PostgREST<br/>table CRUD + RPC"]
    StorageAPI["Supabase Storage API<br/>bucket object access"]
    RLS["Row-Level Security Policies<br/>role and ownership checks"]
    Triggers["Postgres Functions + Triggers<br/>handle_new_user, has_role, set_updated_at"]
  end

  subgraph DatabaseLayer["Database Layer"]
    AuthUsers["auth.users<br/>Supabase-managed users"]
    Identity["profiles<br/>user_roles"]
    RoleProfiles["student_profiles<br/>investor_profiles"]
    PitchCore["pitches<br/>bookmarks<br/>messages"]
    AdminData["deals<br/>transactions<br/>audit_logs<br/>platform_settings<br/>database_backups"]
    Buckets["Storage Buckets<br/>pitch-decks private<br/>pitch-thumbnails public<br/>identity-cards private<br/>profile-photos referenced in app"]
  end

  subgraph ExternalServices["External Services"]
    Google["Google OAuth"]
    Lovable["Lovable Cloud Auth<br/>OAuth broker used by GoogleSignInButton"]
    SupabasePlatform["Supabase Managed Platform"]
  end

  subgraph Infrastructure["Infrastructure"]
    Vite["Vite build/dev server<br/>dev port 8080"]
    StaticHost["Static web host / CDN<br/>deployment target not specified in repo"]
    Env["VITE_SUPABASE_URL<br/>VITE_SUPABASE_PUBLISHABLE_KEY"]
    Migrations["supabase/migrations<br/>schema, RLS, buckets"]
  end

  Public --> Browser
  Students --> Browser
  Investors --> Browser
  Admins --> Browser

  Browser -->|"loads optimized assets"| StaticHost
  StaticHost --> SPA
  Vite --> StaticHost
  Env --> Client

  SPA --> Router
  SPA --> UI
  Router --> AuthGuard
  AuthGuard -->|"session + role lookup"| Client
  Query -->|"queries and mutations"| Client
  SPA --> Query

  Client ==>|"critical auth path"| Auth
  Client ==>|"critical data path: PostgREST CRUD/RPC"| DataAPI
  Client ==>|"critical file path: upload/download"| StorageAPI

  Google --> Lovable
  Lovable -->|"OAuth redirect/callback"| Auth
  Auth --> AuthUsers
  Auth -->|"on_auth_user_created"| Triggers
  Triggers --> Identity
  Triggers --> RoleProfiles

  DataAPI --> RLS
  RLS --> Identity
  RLS --> RoleProfiles
  RLS --> PitchCore
  RLS --> AdminData

  StorageAPI -->|"object policies"| RLS
  StorageAPI --> Buckets
  PitchCore -.->|"deck_url / thumbnail_url"| Buckets
  RoleProfiles -.->|"profile and identity URLs"| Buckets

  SupabasePlatform --> Auth
  SupabasePlatform --> DataAPI
  SupabasePlatform --> StorageAPI
  SupabasePlatform --> AuthUsers

  Migrations --> Identity
  Migrations --> RoleProfiles
  Migrations --> PitchCore
  Migrations --> AdminData
  Migrations --> Buckets

  class Browser,Public,Students,Investors,Admins client
  class SPA,Router,AuthGuard,Query,UI,Client frontend
  class Auth,DataAPI,StorageAPI,RLS,Triggers backend
  class AuthUsers,Identity,RoleProfiles,PitchCore,AdminData,Buckets database
  class Google,Lovable,SupabasePlatform external
  class Vite,StaticHost,Env,Migrations infra
  class Auth,DataAPI,StorageAPI,RLS critical
